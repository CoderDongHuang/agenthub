# AI Agent Hub — 环境变量配置
# 复制此文件为 .env，至少填一个 API Key 即可启动
# 支持 12 家公司 24 个模型，每家公司推理最强 + 速度最快各一个

# ── DeepSeek（推荐）──
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ── OpenAI ──
OPENAI_API_KEY=sk-your-openai-key
# 国内无法直连时，配中转地址（api2d / openai-sb 等，或自建 Nginx 反代）
# OPENAI_BASE_URL=https://your-proxy.com/v1

# ── Anthropic Claude ──
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# 国内无法直连时，配中转地址
# ANTHROPIC_BASE_URL=https://your-proxy.com

# ── 阿里通义千问 ──
DASHSCOPE_API_KEY=sk-your-qwen-key

# ── Moonshot Kimi ──
MOONSHOT_API_KEY=sk-your-moonshot-key

# ── 智谱 GLM ──
ZHIPU_API_KEY=your-zhipu-key

# ── 百川 ──
BAICHUAN_API_KEY=sk-your-baichuan-key

# ── xAI Grok（马斯克）──
XAI_API_KEY=xai-your-grok-key

# ── Mistral AI（法国）──
MISTRAL_API_KEY=your-mistral-key

# ── 科大讯飞 星火 ──
SPARK_API_KEY=your-spark-key

# ── 腾讯混元 ──
HUNYUAN_API_KEY=your-hunyuan-key

# ── MiniMax ──
MINIMAX_API_KEY=your-minimax-key

# ── 数据库（开发环境默认值）──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agenthub
DB_USER=agenthub
DB_PASSWORD=agenthub123

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://:123456@localhost:6380/0
AGENTHUB_SECURE_COOKIE=false

# Optional channel credentials. Keep real values in .env only.
DINGTALK_WEBHOOK_URL=
DINGTALK_SIGN_SECRET=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
WECHAT_CORP_ID=
WECHAT_AGENT_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=
# Keep empty until an enterprise-owned, WeCom-verified HTTPS domain is available.
WECHAT_CALLBACK_URL=
CHANNEL_DEFAULT_AGENT_ID=1

# ── JWT 密钥（生产环境必须修改）──
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_256_BIT_KEY
# Optional dedicated KMS root. When omitted, the JWT secret is used as the local development root.
# Use at least 32 random bytes and never commit the real value.
AGENTHUB_KMS_MASTER_KEY=
# Optional dedicated root for signing private tool/plugin packages.
# When omitted, the KMS/JWT development root is used. Never commit the real value.
AGENTHUB_ECOSYSTEM_SIGNING_KEY=
# Java/Python internal communication
JAVA_CONSOLE_URL=http://localhost:8080
AGENTHUB_INTERNAL_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
AGENTHUB_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# ── 性能与稳定性（以下均为可选）──
AGENTHUB_CHAT_MAX_CONCURRENCY=16
AGENTHUB_CHAT_QUEUE_CAPACITY=64
LLM_MODEL_CACHE_SIZE=16
LLM_MODEL_CACHE_TTL_SECONDS=3600
LLM_MAX_CONCURRENCY_PER_TENANT_MODEL=4
TOOL_MAX_CONCURRENCY=8
UVICORN_RELOAD=false
